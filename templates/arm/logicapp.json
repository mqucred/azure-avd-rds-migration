                            },
                            {
                                "address": "ipAddress"
                            },
                            {
                                "address": "ipAddress"
                            }
                        ]
                    }
                }
            }
        },
        {
            "type": "Microsoft.Logic/workflows/accessKeys",
            "apiVersion": "2015-02-01-preview",
            "name": "[concat(parameters('workflows_la_avd_soc_001_name'), '/default')]",
            "dependsOn": [
                "[resourceId('Microsoft.Logic/workflows', parameters('workflows_la_avd_soc_001_name'))]"
            ],
            "properties": {}
        }
    ]
}