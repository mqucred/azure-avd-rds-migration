                                "address": "ipAddress"
                            },
                            {   
                                "address": "ipAddress"
                            },
                            {
                                "address": "ipAddress"
                            }
                        ]
                    },
                    "connector": {
                        "outgoingIpAddresses": [
                            {
                                "address": "ipAddress"
                            },
                            {
                                "address": "ipAddress"
                            },
                            {
                                "address": "ipAddress"
                            },
                            {
                                "address": "ipAddress"
                            },
                            {
                                "address": "ipAddress"
                            },
                            {
